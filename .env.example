# --- LLM для планирования (сценарий -> таймлайн) ---
# ollama | openrouter
KONODEN_LLM_BACKEND=ollama

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# --- OpenRouter (транскрипция Whisper + опциональный chat-бэкенд) ---
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_CHAT_MODEL=qwen/qwen-2.5-72b-instruct
# slug проверяй через: GET /api/v1/models?output_modalities=transcription
KONODEN_STT_MODEL=openai/whisper-large-v3

# --- Сток-видео (достаточно одного ключа) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
KONODEN_CACHE_DIR=cache
